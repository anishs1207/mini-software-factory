region               = "ap-south-1"
aws_profile          = "default"
ssh_allowed_cidr     = "REPLACE_WITH_YOUR_PUBLIC_IP/32"
ssh_public_key_path  = "~/.ssh/briefing_aws.pub"
ssh_private_key_path = "~/.ssh/briefing_aws"
spec_path            = "spec/PRODUCT_SPEC.md"
