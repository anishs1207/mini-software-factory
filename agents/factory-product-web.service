[Unit]
Description=Factory product web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/factory-product/current
Environment=FACTORY_DATA_DIR=/home/ubuntu/factory-product/data
Environment=FACTORY_RELEASE_ROOT=/home/ubuntu/factory-product
Environment=FACTORY_CURRENT_DIR=/home/ubuntu/factory-product/current
Environment=HOME=/home/ubuntu/factory-product/runtime-home
ExecStart=/bin/bash /home/ubuntu/factory-product/current/product-service.sh serve
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
