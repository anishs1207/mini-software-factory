# Copy to secrets.env; chmod 600. Use a new key, never commit this file.
OLLAMA_API_KEY='replace-me'
OPENCLAW_BUILDER_MODEL='ollama-cloud/minimax-m2.7'
HERMES_MANAGER_MODEL='gpt-oss:120b'
HERMES_REVIEWER_MODEL='gpt-oss:120b'
HERMES_TESTER_MODEL='gpt-oss:20b'
# Required free fallback. Replace model IDs with current OpenRouter :free models.
OPENROUTER_API_KEY='replace-me'
OPENCLAW_FALLBACK_MODEL='openrouter/REPLACE_WITH_FREE_MODEL:free'
HERMES_FALLBACK_MODEL='REPLACE_WITH_FREE_MODEL:free'
