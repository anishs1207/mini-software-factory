# Copy to secrets.env; chmod 600. Use a new key, never commit this file.
OLLAMA_API_KEY='replace-me'
OLLAMA_BASE_URL='https://ollama.com/v1'
OLLAMA_MODEL='beam:cloud'
# Strong reasoning for the Hermes manager and reviewer; keep the :free suffix.
OPENROUTER_API_KEY='replace-me'
OPENROUTER_REASONING_MODEL='nvidia/nemotron-3-ultra-550b-a55b:free'
# Your existing GitHub repo write token for noninteractive bootstrap.
GH_TOKEN='replace-me'
