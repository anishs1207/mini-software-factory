# Use a token that can read the target repositories and create PR reviews.
GH_TOKEN=
GITHUB_OWNER=anishs1207
# OpenAI compatible chat completions endpoint. A separate model key is required.
REVIEW_API_KEY=
REVIEW_BASE_URL=https://api.openai.com/v1
REVIEW_MODEL=gpt-5.1
POLL_SECONDS=300
# Optional: comma-separated owner/repo allowlist. Empty means all accessible repos owned by GITHUB_OWNER.
REVIEW_REPOS=
